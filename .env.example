# Copy this file to ".env" and fill in the values.
# In production, set the same variables in the Vercel project settings.

# --- Microsoft Entra ID app registration (used to call Microsoft Graph) ---
# Client secret expires 2028/09/04; generate a new one in Microsoft Entra ID.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- SharePoint ---
# ID of the SharePoint site that holds the form lists
# (run "node list-sites.js" to find it)
SITE_ID=

# --- SharePoint list IDs, one per form in data/forms.js (envListIdKey) ---
# (run "node get-lists.js" to find them)
CONTACT_LIST_ID=
CHECKOUT_CHARITY_LIST_ID=
# PATIENT_REGISTRATION_LIST_ID=
